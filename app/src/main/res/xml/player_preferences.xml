<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/video_playback">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            android:icon="@drawable/ic_video"
            android:key="scrub_preview_mini"
            app:summary="@string/scrub_preview_mini_summary"
            app:title="@string/scrub_preview_mini" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/device_files_title">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            android:icon="@drawable/baseline_folder_24"
            android:key="show_device_files"
            app:summary="@string/show_device_files_summary"
            app:title="@string/show_device_files" />

        <Preference
            android:icon="@drawable/baseline_folder_24"
            app:isPreferenceVisible="false"
            app:key="device_files_folder"
            app:persistent="false"
            app:summary="@string/device_files_folder_summary"
            app:title="@string/device_files_folder" />

        <Preference
            android:icon="@drawable/ic_folder_delete"
            app:isPreferenceVisible="false"
            app:key="device_files_clear_folder"
            app:persistent="false"
            app:summary="@string/device_files_clear_folder_summary"
            app:title="@string/device_files_clear_folder" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/lyrics">
        <ListPreference
            android:icon="@drawable/baseline_color_lens_24"
            android:defaultValue="default"
            android:entries="@array/lyrics_text_colors"
            android:entryValues="@array/lyrics_text_color_values"
            app:key="lyrics_text_color"
            app:summary="@string/lyrics_text_color_summary"
            app:title="@string/lyrics_text_color" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            android:icon="@drawable/ic_lyrics"
            android:key="lyrics_prefer_word_sync"
            app:summary="@string/lyrics_prefer_word_sync_summary"
            app:title="@string/lyrics_prefer_word_sync" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/lyrics_providers">
        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            android:icon="@drawable/ic_lyrics"
            android:key="lyrics_provider_betterlyrics"
            app:summary="@string/lyrics_provider_betterlyrics_summary"
            app:title="@string/lyrics_provider_betterlyrics" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            android:icon="@drawable/ic_subtitles"
            android:key="lyrics_provider_lyricsplus"
            app:summary="@string/lyrics_provider_lyricsplus_summary"
            app:title="@string/lyrics_provider_lyricsplus" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            android:icon="@drawable/ic_lyrics"
            android:key="lyrics_provider_lrclib"
            app:summary="@string/lyrics_provider_lrclib_summary"
            app:title="@string/lyrics_provider_lrclib" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            android:icon="@drawable/ic_subtitles_alternative"
            android:key="lyrics_provider_youtube_subs"
            app:summary="@string/lyrics_provider_youtube_subs_summary"
            app:title="@string/lyrics_provider_youtube_subs" />
    </PreferenceCategory>

</PreferenceScreen>
