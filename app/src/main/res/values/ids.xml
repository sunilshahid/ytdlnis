<?xml version="1.0" encoding="utf-8"?>
<!--
    IDs that used to be generated by navigation graphs / menus / layouts which were
    removed during the Compose migration, but are still referenced from Kotlin code.

    Settings destinations are now built programmatically in
    ui/more/settings/SettingsNavGraph.kt, so their destination and action ids have to
    be declared explicitly. The same applies to the action-mode menu item ids that are
    created with Menu.add(Menu.NONE, R.id.x, ...) at runtime.
-->
<resources>
    <!-- Main shell fragment container (Compose AndroidView host) -->
    <item name="frame_layout" type="id" />

    <!-- Settings destinations (programmatic NavGraph) -->
    <item name="generalSettingsFragment" type="id" />
    <item name="advancedSettingsFragment" type="id" />
    <item name="temporaryFilesFragment" type="id" />
    <item name="ytdlpUpdateSettingsFragment" type="id" />
    <item name="appUpdateSettingsFragment" type="id" />
    <item name="changeLogFragment" type="id" />
    <item name="packagesFragment" type="id" />
    <item name="youtubePlayerClientFragment" type="id" />
    <item name="generateYoutubePoTokensFragment" type="id" />

    <!-- Settings actions -->
    <item name="action_mainSettingsFragment_to_generalSettingsFragment" type="id" />
    <item name="action_mainSettingsFragment_to_advancedSettingsFragment" type="id" />
    <item name="action_folderSettingsFragment_to_temporaryFilesFragment" type="id" />
    <item name="action_updateSettingsFragment_to_changeLogFragment" type="id" />
    <item name="action_updateSettingsFragment_to_packagesFragment" type="id" />
    <item name="action_updateSettingsFragment_to_ytdlpUpdateSettingsFragment" type="id" />
    <item name="action_updateSettingsFragment_to_appUpdateSettingsFragment" type="id" />
    <item name="action_advancedSettingsFragment_to_youtubePlayerClientFragment" type="id" />
    <item name="action_advancedSettingsFragment_to_generateYoutubePoTokensFragment" type="id" />

    <!-- Share/download dialog actions (share_nav_graph.xml) -->
    <item name="action_downloadBottomSheetDialog_to_downloadsAlreadyExistDialog2" type="id" />
    <item name="action_selectPlaylistItemsDialog_to_downloadBottomSheetDialog" type="id" />
    <item name="action_selectPlaylistItemsDialog_to_downloadMultipleBottomSheetDialog" type="id" />

    <!-- Terminal destinations (terminal_graph.xml) -->
    <item name="terminalFragment" type="id" />

    <!-- Action-mode menu item ids (menus were replaced by programmatic menus) -->
    <item name="select_between" type="id" />
    <item name="select_all" type="id" />
    <item name="invert_selected" type="id" />
    <item name="delete" type="id" />
    <item name="delete_results" type="id" />
    <item name="export_clipboard" type="id" />
</resources>
