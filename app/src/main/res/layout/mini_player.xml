<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mini_player"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="8dp"
    android:visibility="gone"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/mini_player_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Square-rounded Artwork with Shared Element Transition (ShapeableImageView) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/mini_player_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/now_playing"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music"
            android:transitionName="artwork_transition"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MiniPlayerArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mini_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mini_player_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11.5sp" />

        </LinearLayout>

        <!-- Expressive Play/Pause Pill Button -->
        <ImageButton
            android:id="@+id/mini_player_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_player_play_expressive"
            android:contentDescription="@string/play"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lyrics_play"
            app:tint="?attr/colorOnPrimaryContainer" />

        <!-- Next Track Button -->
        <ImageButton
            android:id="@+id/mini_player_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lyrics_forward"
            app:tint="?attr/colorOnSurfaceVariant" />

        <!-- Cross / Close Button -->
        <ImageButton
            android:id="@+id/mini_player_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_cancel"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
