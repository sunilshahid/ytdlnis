<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/device_grid_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="132dp">

            <ImageView
                android:id="@+id/device_grid_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music" />

            <ImageView
                android:id="@+id/device_grid_playing"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|start"
                android:layout_margin="7dp"
                android:background="@drawable/bg_row_badge"
                android:contentDescription="@string/now_playing"
                android:padding="4dp"
                android:src="@drawable/ic_equalizer"
                android:visibility="gone"
                app:tint="@android:color/white" />

            <ImageView
                android:id="@+id/device_grid_type_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="7dp"
                android:background="@drawable/bg_row_badge"
                android:contentDescription="@null"
                android:padding="3dp"
                android:src="@drawable/ic_video"
                android:visibility="gone"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/device_grid_menu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="5dp"
                android:background="@drawable/bg_row_badge"
                android:contentDescription="@string/more"
                android:padding="6dp"
                android:src="@drawable/baseline_more_vert_24"
                app:tint="@android:color/white" />

            <View
                android:id="@+id/device_grid_selected_scrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#55000000"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/device_grid_selected_badge"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="7dp"
                android:background="@drawable/bg_speed_pill"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@android:color/white" />

        </FrameLayout>

        <TextView
            android:id="@+id/device_grid_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/device_grid_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingHorizontal="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="9dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
